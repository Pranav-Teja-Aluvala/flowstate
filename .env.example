# Local development only. Use secret-managed credentials outside development.
DATABASE_URL=postgresql://flowstate:flowstate_local_only@localhost:54329/flowstate
COLLABORATION_SECRET=replace-with-at-least-32-random-characters
COLLABORATION_PORT=1234
ALLOWED_ORIGINS=http://localhost:3000
POSTGRES_PASSWORD=replace-with-a-random-url-safe-password-for-compose

# GitHub App: user authorization, selected repository installation
APP_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=
GITHUB_TOKEN_KEY=
# Local runner: run as a separate host process, never inside the web app
RUNNER_PORT=1236
RUNNER_ENABLED=false
RUNNER_IMAGE=flowstate-runner:local
RUNNER_INTERNAL_URL=http://127.0.0.1:1236
