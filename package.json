{
  "name": "flowstate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "node scripts/selfhost.mjs setup",
    "selfhost": "node scripts/selfhost.mjs start",
    "selfhost:stop": "node scripts/selfhost.mjs stop",
    "selfhost:logs": "node scripts/selfhost.mjs logs",
    "doctor": "node scripts/selfhost.mjs doctor",
    "dev": "npm run dev -w @flowstate/web",
    "dev:collaboration": "tsx apps/collaboration/src/index.ts",
    "dev:runner": "tsx apps/runner/src/index.ts",
    "build": "npm run build -w @flowstate/web",
    "start": "npm run start -w @flowstate/web",
    "typecheck": "tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p apps/collaboration/tsconfig.json && tsc --noEmit -p apps/runner/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx packages/database/migrate.ts",
    "db:local": "tsx scripts/local-postgres.ts",
    "test:e2e": "playwright test",
    "test:code": "playwright test --config playwright.code.config.ts",
    "test:docker": "vitest run --config vitest.docker.config.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@hocuspocus/provider": "^4.8.0",
    "@hocuspocus/server": "^4.8.0",
    "@tiptap/extension-collaboration": "^3.33.0",
    "@tiptap/extension-collaboration-caret": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "dockerode": "^5.0.1",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.70.0",
    "next": "^16.4.5",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tar-stream": "^3.2.2",
    "ws": "^8.22.2",
    "y-codemirror.next": "^0.3.6",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/dockerode": "^4.0.2",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/tar-stream": "^3.1.5",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "^18.6.0-beta.19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
