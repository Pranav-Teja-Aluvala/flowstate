COLLABORATION_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_COLLABORATION_URL=ws://localhost:1234

APP_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=
GITHUB_TOKEN_KEY=
RUNNER_INTERNAL_URL=http://127.0.0.1:1236
NEXT_PUBLIC_RUNNER_URL=ws://localhost:1236
