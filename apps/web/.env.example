# Must match the root database connection. Next.js reads this app's .env.local.
DATABASE_URL=postgresql://flowstate:flowstate_local_only@localhost:54329/flowstate
COLLABORATION_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_COLLABORATION_URL=ws://localhost:1234

APP_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=
GITHUB_TOKEN_KEY=
RUNNER_INTERNAL_URL=http://127.0.0.1:1236
RUNNER_ENABLED=false
FILE_STORAGE_PROVIDER=local
# Optional managed storage; server-only credentials. Never use NEXT_PUBLIC_ for keys.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=flowstate-files
# Optional separate office service. Keep the shared JWT secret server-only.
OFFICE_PUBLIC_URL=http://127.0.0.1:8082
OFFICE_INTERNAL_URL=http://localhost:8082
OFFICE_APP_URL=http://host.docker.internal:3000
OFFICE_JWT_SECRET=
# Optional error monitoring, disabled when these values are empty.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_RUNNER_URL=ws://localhost:1236
